{
  "$schema": "https://calavera.schalkneethling.com/calavera.config.schema.json",
  "version": 1,
  "profile": "minimal",
  "packageManager": "npm",
  "integrations": [
    "github-repository-controls"
  ],
  "integrationOptions": {
    "github-repository-controls": {
      "repository": "schalkneethling/homebrew-dotdrawer",
      "requireCodeqlResults": true,
      "requiredChecks": [],
      "mergeMethods": [
        "squash"
      ],
      "codeqlLanguages": [
        "ruby"
      ]
    }
  },
  "scripts": {}
}
